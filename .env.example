# Autoridad Seguros AI™ — Variables de Entorno
# Copia a .env.local y rellena los valores reales.
# NUNCA commitear .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ELITE_MONTHLY=price_...
STRIPE_PRICE_ELITE_ANNUAL=price_...

ANTHROPIC_API_KEY=sk-ant-...

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generar con: openssl rand -hex 32
CRON_SECRET=replace-with-random-32-char-secret

# ─── Resend (correos transaccionales) ────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Autoridad Seguros AI™ <hola@tu-dominio.com>

# Staging: emails solo se envían a estas direcciones (coma separado)
# En producción: dejar vacío o establecer RESEND_PRODUCTION=true
RESEND_TEST_EMAILS=tu@email.com,otro@email.com
RESEND_PRODUCTION=false
